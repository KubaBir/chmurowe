# Copy to secrets.yaml (do not commit), fill a strong password, then:
#   kubectl apply -f secrets.yaml
#
apiVersion: v1
kind: Secret
metadata:
  name: chmurowe-secrets
type: Opaque
stringData:
  postgres-password: "CHANGE_ME_STRONG_PASSWORD"
  # Full URL must match postgres-password above (user spotify, db spotify_db, service db-service)
  database-url: "postgresql://spotify:CHANGE_ME_STRONG_PASSWORD@db-service:5432/spotify_db"
